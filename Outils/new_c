#!/bin/bash

# Arrêter le script en cas d'erreur inattendue
set -e

# 1. Vérification du paramètre (si le nom du fichier est fourni)
if [ -z "$1" ]; then
    echo "Erreur : Tu dois spécifier un nom de fichier."
    echo "Usage : new_c nom_fichier"
    exit 1
fi

NOM_FICHIER="$1"

# Ajoute automatiquement .c si l'utilisateur ne l'a pas écrit
if [[ "$NOM_FICHIER" != *.c ]]; then
    NOM_FICHIER="${NOM_FICHIER}.c"
fi

# Extraction du nom seul sans extension pour l'en-tête
NOM_SANS_EXT="${NOM_FICHIER%.c}"

# 2. Vérification que la variable d'environnement ZYNTHAR_ROOT existe
if [ -z "$ZYNTHAR_ROOT" ]; then
    echo "Erreur : La variable \$ZYNTHAR_ROOT n'est pas définie."
    echo "💡 Pensez à recharger votre terminal ou exécuter : source ~/.bashrc"
    exit 1
fi

# Alignement sur la nouvelle arborescence (Dossier partagé/template)
SOURCE="$ZYNTHAR_ROOT/shared/template/template.c"
DESTINATION="./$NOM_FICHIER"

# 3. Vérification que le fichier template existe bien
if [ ! -f "$SOURCE" ]; then
    echo "Erreur : Le fichier template n'existe pas dans $SOURCE"
    exit 1
fi

# 4. Alerte si le fichier de destination existe déjà
if [ -f "$DESTINATION" ]; then
    echo "Alerte : Le fichier '$NOM_FICHIER' existe déjà dans le répertoire courant. Opération annulée."
    exit 1
fi

# 5. Copie du fichier
cp "$SOURCE" "$DESTINATION"

# 6. Remplacement des placeholders (Date et Nom de fichier)
DATE_DU_JOUR=$(date +%d/%m/%Y)

# -i permet de modifier le fichier directement (in-place)
sed -i "s|xx/xx/xxxx|$DATE_DU_JOUR|g" "$DESTINATION"
sed -i "s|----------|$NOM_SANS_EXT|g" "$DESTINATION"

echo "Succès : '$NOM_FICHIER' a été créé avec succès dans le répertoire courant."
